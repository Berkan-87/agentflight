  "repository": {
    "type": "git",
    "url": "https://github.com/kullanici/agentflight.git"
  },
  "homepage": "https://github.com/kullanici/agentflight#readme",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "dotenv": "^18.0.8",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "peerDependencies": {
    "ai": ">=4.0.0",
    "@ai-sdk/openai": ">=1.0.0"
